<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>learning_tf2_cpp</name>
  <version>0.0.1</version>  <!-- Updated version to a non-zero value -->
  <description>Learning TF2 in C++</description>  <!-- Updated description -->
  <maintainer email="samikshaambastha9308@gmail.com">samiksha</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Use <depend> for build and exec dependencies -->
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>turtlesim</depend>
  <depend>tf2_geometry_msgs</depend>  <!-- Keep this as a build dependency -->
  <depend>message_filters</depend>

  <!-- Use <exec_depend> for runtime dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>